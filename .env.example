# ============================================================================
# MiniBites AI Studio — environment variables (NAMES ONLY, never real values)
# Configure in Vercel: Project → Settings → Environment Variables
# ============================================================================

# --- Authentication (REQUIRED — generation stays locked without it) --------
# Password that unlocks the studio UI/API.
APP_ACCESS_PASSWORD=
# Secret used to sign the session cookie (any long random string).
SESSION_SECRET=
# Optional separate password for the unlinked /operations dashboard.
ADMIN_ACCESS_PASSWORD=

# --- Database (recommended for production) ---------------------------------
# Upstash Redis REST credentials. Without them the app uses a NON-DURABLE
# in-memory store: fine for local dev, jobs may reset on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Video provider ---------------------------------------------------------
# One of: fal | wan | mock   (mock is testing-only and clearly labeled)
VIDEO_PROVIDER=fal
# fal.ai (paid, pay-per-generation). Key from https://fal.ai dashboard.
FAL_KEY=
# fal model route, e.g. a Wan or Kling text-to-video model. Verify the current
# id on the model's fal page before production use.
FAL_MODEL_ID=fal-ai/wan/v2.2-a14b/text-to-video
FAL_ESTIMATED_COST_PER_SECOND_USD=
# Self-hosted open-source Wan worker (lowest cost when you control a GPU).
WAN_VIDEO_ENDPOINT=
WAN_VIDEO_TOKEN=

# --- Planning LLM (optional — template plan used when absent) ---------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_ESTIMATED_COST_PER_SECOND_USD=

# --- Storage (recommended for production) ----------------------------------
# Vercel Blob archives the final MP4 so provider URLs can expire safely.
BLOB_READ_WRITE_TOKEN=
# Future S3-compatible adapter placeholders.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Publishing: YouTube Shorts (manual approval only) ----------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=private

# --- Publishing: TikTok (requires TikTok Content Posting API approval) ------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY

# --- Publishing: Instagram Reels (requires Business account + Graph API) ----
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Publishing: X / Twitter (requires developer app with media upload) -----
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Publishing: Snapchat Spotlight -----------------------------------------
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REFRESH_TOKEN=

# --- Cost protection --------------------------------------------------------
MAX_PRODUCTIONS_PER_DAY=5
